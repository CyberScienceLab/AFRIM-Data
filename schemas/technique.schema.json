{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://afirm.cybersciencelab.com/schemas/technique.schema.json",
  "title": "AFIRM Technique",
  "type": "object",
  "required": ["id", "name", "phase", "evidence_classes", "access_capability", "maturity", "status"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$",
      "description": "Technique ID. Sub-techniques use a dotted suffix, e.g. T0104.001."
    },
    "name": { "type": "string", "minLength": 1 },
    "phase": {
      "type": "string",
      "enum": ["P01", "P02", "P03", "P04", "P05"]
    },
    "sub_of": {
      "type": ["string", "null"],
      "pattern": "^T[0-9]{4}$"
    },
    "evidence_classes": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "access_capability": {
      "type": "array",
      "items": { "type": "string", "enum": ["W", "G", "B"] },
      "description": "Coverage/reachability only \u2014 not a claim-strength scale (Principle 5)."
    },
    "evidence_role": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["source", "reference", "investigator_generated", "derived_work_product", "corroborative_external"]
      }
    },
    "maturity": {
      "type": "object",
      "required": ["base"],
      "properties": {
        "base": { "type": "string", "enum": ["Established", "Demonstrated", "Proposed"] },
        "qualification": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "lifecycle_stages": {
      "type": "array",
      "items": { "type": "string" }
    },
    "readiness_measures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "relationship"],
        "properties": {
          "id": { "type": "string", "pattern": "^R[0-9]{4}$" },
          "relationship": { "type": "string", "enum": ["required", "enabling", "strengthening"] }
        }
      }
    },
    "description": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] },
    "classical_ancestry": { "type": ["string", "null"] },
    "claim_profile": {
      "type": "object",
      "properties": {
        "does_establish": { "type": "array", "items": { "type": "string" } },
        "does_not_establish": { "type": "array", "items": { "type": "string" } },
        "alternative_propositions": { "type": "array", "items": { "type": "string" } },
        "corroboration_requirements": { "type": "array", "items": { "type": "string" } },
        "quality_controls": { "type": "array", "items": { "type": "string" } },
        "stop_conditions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "status"],
        "properties": {
          "text": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "verify"] }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated", "superseded", "withdrawn"]
    },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "supersedes": { "type": ["string", "null"] },
    "replaced_by": { "type": ["string", "null"] }
  }
}
