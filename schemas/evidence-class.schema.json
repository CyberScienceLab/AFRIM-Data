{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://firai.cybersciencelab.com/schemas/evidence-class.schema.json",
  "title": "FIRAI Evidence Class",
  "type": "object",
  "required": ["id", "name", "volatility_rank"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^EC[0-9]{2}$" },
    "name": { "type": "string" },
    "volatility_rank": { "type": "integer", "minimum": 1, "maximum": 7 },
    "contents": { "type": ["string", "null"] },
    "volatility_driver": { "type": ["string", "null"] }
  }
}
