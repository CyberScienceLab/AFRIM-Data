{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://afirm.cybersciencelab.com/schemas/readiness.schema.json",
  "title": "AFIRM Forensic Readiness Measure",
  "type": "object",
  "required": ["id", "name"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^R[0-9]{4}$" },
    "name": { "type": "string" },
    "type": { "type": "string" },
    "description": { "type": ["string", "null"] }
  }
}
